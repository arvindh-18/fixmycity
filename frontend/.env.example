# Optional in dev (default: empty string = same origin, using Vite's dev proxy).
# In production on Vercel, set this to your backend public URL (e.g. Render):
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Optional. Vector map style (any MapLibre style URL). Default: OpenFreeMap "positron" (OpenStreetMap data, no key).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional. Where the dev server proxies /api, /media and /ws. Default: http://localhost:8000
# VITE_API_PROXY=http://localhost:8000
