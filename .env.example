# Copy to .env (in the project root or backend/). Every value is optional for local dev.

# --- Supabase Authentication -------------------------------------------------
# Supabase dashboard → Project Settings → API Keys (Project URL & Anon / Publishable key).
# Leave empty locally to get one-click demo sign-in instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Three logins: residents (anyone), field workers and city admins.
# Emails that are city admins (full control: status, delete, manage team). Comma-separated.
ADMIN_EMAILS=
# Emails that are field workers / servicemen (can mark "Being fixed" / "Fixed").
# Admins can also add workers from the Admin page, so this is optional.
WORKER_EMAILS=

# --- Gemini (photo → draft report, voice fallback) -----------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Database --------------------------------------------------------------------
# Local default is a SQLite file. In the cloud use any Postgres URL (Render, Neon, Supabase…).
# DATABASE_URL=postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./fixmycity.db

# --- Map defaults -----------------------------------------------------------------
CITY_NAME=Chennai
CITY_LAT=13.0827
CITY_LNG=80.2707
COUNTRY_CODES=in
# Nominatim asks apps to identify themselves; put a contact email or URL here.
NOMINATIM_CONTACT=

# Only needed if the frontend is hosted on a different domain from the API.
# CORS_ORIGINS=https://your-frontend.web.app

# --- Demo build (never in production) -------------------------------------------------
# One-click personas, developer console at /dev, offline AI without a key, and mock data:
#   DEMO_MODE=1 python backend/demo_seed.py   (wipes the database, then seeds ~250 reports)
# DEMO_MODE=1
# DEMO_LAT=13.0287
# DEMO_LNG=80.0168
# DEMO_LABEL=Saveetha Engineering College, Thandalam
