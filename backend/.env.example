# ---- Required -------------------------------------------------------------
# PostgreSQL + PostGIS connection (docker compose default shown)
DATABASE_URL=postgresql+psycopg://openward:openward@localhost:5432/openward
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Optional -------------------------------------------------------------
ENVIRONMENT=development
JWT_EXPIRY_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# Photo storage: "local" (saved under backend/media) or "supabase"
STORAGE_BACKEND=local
MAX_UPLOAD_MB=8
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=openward

# AI: "rules" (no key needed — demonstration mode), "anthropic" or "openai" (any OpenAI-compatible API)
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20

# Email notifications: "outbox" (default — writes .eml files to backend/outbox, no mail server needed),
# "smtp" (real email) or "none". Users can switch emails off from their account menu.
EMAIL_BACKEND=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Commons <no-reply@openward.local>
SMTP_STARTTLS=true

# SLA escalation job (runs inside the API process)
ENABLE_BACKGROUND_JOBS=true
ESCALATION_INTERVAL_SECONDS=60

# Map centre for the demo city
CITY_NAME=Bengaluru
CITY_LAT=12.9716
CITY_LNG=77.5946

# Used only by the test suite
TEST_DATABASE_URL=postgresql+psycopg://openward:openward@localhost:5432/openward_test
