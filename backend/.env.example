# =============================================================================
# FixMyCity (Commons) - Backend Environment Configuration
# =============================================================================

# ---- Required -------------------------------------------------------------
# PostgreSQL + PostGIS connection string.
# In local development, the Docker Compose default below is used.
# Supabase connection strings starting with postgresql:// or postgres:// will be
# automatically normalised to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://openward:openward@localhost:5432/openward

# Direct PostgreSQL connection string (bypasses transaction pooler).
# Used by Alembic migrations when deploying against Supabase with PgBouncer/Supavisor.
# When unset, Alembic falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Set to true when connecting through Supabase's transaction pooler (port 6543).
# Disables prepared statements (prepare_threshold: None) in psycopg 3 to avoid pooler errors.
# DB_USE_POOLER=false

# Long random string used to sign login JWT tokens.
# IN PRODUCTION (ENVIRONMENT=production), THIS MUST NOT BE THE DEV DEFAULT OR STARTUP WILL FAIL!
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Optional / Environment Defaults --------------------------------------
ENVIRONMENT=development
JWT_EXPIRY_HOURS=12

# Allowed origins for CORS (comma-separated).
# In production, set to your Vercel frontend domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (used in email links / action buttons).
FRONTEND_URL=http://localhost:5173

# Public base URL of the backend API (used in public asset links).
PUBLIC_BASE_URL=http://localhost:8000

# Photo storage: "local" (saved under backend/media) or "supabase"
STORAGE_BACKEND=local
MAX_UPLOAD_MB=8
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=openward

# AI: "rules" (no key needed — demonstration mode), "anthropic" or "openai" (any OpenAI-compatible API)
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20

# Email notifications: "outbox" (default — writes .eml files to backend/outbox, no mail server needed),
# "smtp" (real email) or "none". Users can switch emails off from their account menu.
EMAIL_BACKEND=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Commons <no-reply@openward.local>
SMTP_STARTTLS=true

# SLA escalation job (runs inside the single API process)
ENABLE_BACKGROUND_JOBS=true
ESCALATION_INTERVAL_SECONDS=60

# Map centre for the demo city
CITY_NAME=Bengaluru
CITY_LAT=12.9716
CITY_LNG=77.5946

# Used only by the test suite
TEST_DATABASE_URL=postgresql+psycopg://openward:openward@localhost:5432/openward_test

# =============================================================================
# Production Example (Render Web Service + Supabase + Vercel)
# =============================================================================
# ENVIRONMENT=production
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DIRECT_DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DB_USE_POOLER=true
# JWT_SECRET=s0m3-v3ry-l0ng-r4nd0m-s3cr3t-str1ng-f0r-jwt-pr0ducti0n
# CORS_ORIGINS=https://fixmycity.vercel.app
# FRONTEND_URL=https://fixmycity.vercel.app
# PUBLIC_BASE_URL=https://fixmycity-backend.onrender.com
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_BUCKET=openward
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_...
# SMTP_FROM=FixMyCity <updates@yourdomain.com>
# SMTP_STARTTLS=true
